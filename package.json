{
  "name": "orchid-git",
  "productName": "Orchid Git",
  "version": "0.9.2",
  "description": "Orchid Git - A desktop Git client with graph visualization, conflict resolution, and interactive rebase",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "generate:assets": "node scripts/generate-installer-gif.js",
    "make": "node scripts/generate-installer-gif.js && electron-forge make",
    "publish:release": "node scripts/publish-release.js",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "test": "jest",
    "test:e2e": "node test/e2e/global-setup.js && jest --config test/e2e/jest.e2e.config.js",
    "test:e2e:setup": "node test/e2e/global-setup.js"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.25.9",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron-forge/plugin-webpack": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.0.0",
    "electron": "33.2.1",
    "express": "^5.2.1",
    "gif-encoder": "^0.7.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "node-loader": "^2.0.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6",
    "style-loader": "^3.0.0"
  },
  "keywords": [],
  "author": {
    "name": "leooliveiraz",
    "email": "leopdor@gmail.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "diff": "^9.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  }
